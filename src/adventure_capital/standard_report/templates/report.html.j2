<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <title>{{ data.document.title }} · {{ data.document.company_name }}</title>
  <style>{{ css }}</style>
</head>
<body>
  {% macro footer(page, total) -%}
  <div class="footer">
    <span>Confidencial · Adventure Capital · {{ data.document.report_date }}</span>
    <span>{{ page }}{% if total %} / {{ total }}{% endif %}</span>
  </div>
  {%- endmacro %}

  {% macro narrative_block(block) %}
    {% if block and block.paragraphs %}
    <div class="narrative">
      {% if block.headline %}<div class="narrative-headline">{{ block.headline }}</div>{% endif %}
      {% for paragraph in block.paragraphs %}
      <p>{{ paragraph | markdown_lite }}</p>
      {% endfor %}
    </div>
    {% endif %}
  {% endmacro %}

  {# ================================================================
     Macro: formula_block
     Renderiza un bloque de fórmulas monoespaciado con label.
     Uso: {{ formula_block("Clientes", "Clientes_t = Clientes_{t-1} × (1-churn) + Nuevos_t") }}
     ================================================================ #}
  {% macro formula_block(label, equation) %}
  <div class="formula-container">
    <span class="formula-label">{{ label }}</span>
    <pre class="formula">{{ equation }}</pre>
  </div>
  {% endmacro %}

  {% macro render_table(table, kind="numeric") %}
    {% if table and table.columns %}
    <table class="aggregation {{ 'tight' if (table.rows|length) <= 4 else '' }}">
      <thead>
        <tr>
        {% for col in table.columns %}
          <th>{{ col }}</th>
        {% endfor %}
        </tr>
      </thead>
      <tbody>
        {% for row in table.rows %}
        <tr>
          {% for cell in row %}
            {% if loop.first %}
              <th scope="row">{{ cell }}</th>
            {% else %}
              <td>{{ cell | smart_cell(table.columns[loop.index0]) }}</td>
            {% endif %}
          {% endfor %}
        </tr>
        {% endfor %}
        {% if table.totals %}
        <tr class="totals">
          {% for cell in table.totals %}
            {% if loop.first %}
              <th scope="row">{{ cell }}</th>
            {% else %}
              <td>{{ cell | smart_cell(table.columns[loop.index0]) }}</td>
            {% endif %}
          {% endfor %}
        </tr>
        {% endif %}
      </tbody>
    </table>
    {% endif %}
  {% endmacro %}

  {% set total_pages = 15 if data.document.scope == "ev_only" else 16 %}

  <section class="page cover">
    {% if data.document.scope == "ev_only" %}
      {# Portada minimalista: solo identificadores cuantitativos #}
      <div class="brand">Adventure Capital</div>
      <h1 class="cover-title">{{ data.document.title }}</h1>
      <div class="cover-company" style="font-size: 48px; color: #F59E0B; font-weight: 800; margin: 8px 0 12px;">{{ data.document.company_name }}</div>
      <div class="cover-method" style="font-size: 18px; color: #D1D5DB; margin-bottom: 40px;">Metodología MapValue · DCF · CAPM</div>
      <div class="cover-meta">
        <div><span class="label">Autor</span><span class="value">{{ data.document.author }}</span></div>
        <div><span class="label">Fecha</span><span class="value">{{ data.document.report_date }}</span></div>
        <div><span class="label">Horizonte</span><span class="value">{{ data.dcf.horizonte_meses }} meses</span></div>
        <div><span class="label">WACC</span><span class="value">{{ (data.dcf.tasa_descuento * 100) | round(1) }}%</span></div>
      </div>
    {% else %}
      <div class="brand">Adventure Capital</div>
      <h1>{{ data.document.title }}</h1>
      <div class="hero">{{ data.document.company_name }}</div>
      <div class="subtitle">Plan de aceleración · Valorización · Unit Economics</div>
      <div class="cover-meta">
        <div><span class="label">Autor</span><span class="value">{{ data.document.author }}</span></div>
        <div><span class="label">Fecha</span><span class="value">{{ data.document.report_date }}</span></div>
        <div><span class="label">Método</span><span class="value">DCF · CAPM · Múltiplos</span></div>
      </div>
    {% endif %}
    {{ footer(1, total_pages) }}
  </section>

  {# --- Page 2: Executive summary --- #}
  <section class="page">
    <div class="section-tag">00 · Resumen ejecutivo</div>
    <h2>Resumen ejecutivo</h2>
    <div class="tile-grid three">
      <div class="tile primary">
        <div class="label">Ingresos totales</div>
        <div class="value">{{ data.summary.total_revenue | money_short }}</div>
      </div>
      <div class="tile primary">
        <div class="label">EBITDA total</div>
        <div class="value">{{ data.summary.total_ebitda | money_short }}</div>
      </div>
      <div class="tile primary">
        <div class="label">Caja final</div>
        <div class="value">{{ data.summary.final_cash | money_short }}</div>
      </div>
      <div class="tile">
        <div class="label">Adquisición total</div>
        <div class="value">{{ data.summary.total_acquisition | number_short }}</div>
      </div>
      <div class="tile">
        <div class="label">EBITDA último año</div>
        <div class="value">{{ data.summary.last_year_ebitda | money_short }}</div>
      </div>
      <div class="tile">
        <div class="label">Caja mínima</div>
        <div class="value">{{ data.summary.minimum_cash | money_short }}</div>
      </div>
    </div>
    {{ narrative_block(data.narratives.executive) }}
    {{ footer(2, total_pages) }}
  </section>

  {# --- Page 3: Clientes --- #}
  <section class="page">
    <div class="section-tag">01 · Clientes</div>
    <h2>Clientes: adquisición, churn y stock</h2>
    <div class="grid two">
      <img class="chart" src="{{ data.figures.acquisition_year1 }}" alt="Adquisición año 1">
      <img class="chart" src="{{ data.figures.clients_evolution_36m }}" alt="Evolución de stock de clientes">
    </div>
    <h3>Agregación anual</h3>
    {{ render_table(data.tables.clientes.summary) }}
    <h3>Adquisición por servicio</h3>
    {{ render_table(data.tables.clientes.by_service) }}
    {{ narrative_block(data.narratives.clientes) }}
    {{ footer(3, total_pages) }}
  </section>

  {# --- Page 4: Servicios --- #}
  <section class="page">
    <div class="section-tag">02 · Servicios</div>
    <h2>Servicios: nuevos vs recurrentes</h2>
    <div class="grid two">
      <img class="chart" src="{{ data.figures.services_new_vs_recurrent }}" alt="Servicios nuevos vs recurrentes">
      <div class="tile-grid">
        <div class="tile">
          <div class="label">Servicios totales</div>
          <div class="value">{{ data.tables.servicios.summary.totals[3] | number_short if data.tables.servicios.summary.totals else "—" }}</div>
        </div>
        <div class="tile">
          <div class="label">Nuevos / Recurrentes</div>
          <div class="value">
            {{ data.tables.servicios.summary.totals[1] | number_short }} / {{ data.tables.servicios.summary.totals[2] | number_short }}
          </div>
        </div>
      </div>
    </div>
    <h3>Parámetros por servicio</h3>
    {{ render_table(data.tables.servicios.parameters) }}
    <h3>Agregación anual</h3>
    {{ render_table(data.tables.servicios.summary) }}
    <h3>Servicios por plan</h3>
    {{ render_table(data.tables.servicios.by_service) }}
    {{ narrative_block(data.narratives.servicios) }}
    {{ footer(4, total_pages) }}
  </section>

  {# --- Page 5: Ingresos --- #}
  <section class="page">
    <div class="section-tag">03 · Ingresos</div>
    <h2>Ingresos: composición por servicio</h2>
    <img class="chart" src="{{ data.figures.revenue_breakdown_3y }}" alt="Ingresos anuales por servicio">
    <img class="chart" src="{{ data.figures.revenue_monthly_composition }}" alt="Ingresos mensuales por servicio">
    <h3>Agregación anual</h3>
    {{ render_table(data.tables.ingresos.summary) }}
    {{ narrative_block(data.narratives.ingresos) }}
    {{ footer(5, total_pages) }}
  </section>

  {# --- Page 6: CAC --- #}
  <section class="page">
    <div class="section-tag">04 · CAC</div>
    <h2>CAC: componentes de venta</h2>
    <img class="chart" src="{{ data.figures.cac_components }}" alt="Componentes del CAC anual">
    <h3>Agregación anual</h3>
    {{ render_table(data.tables.cac.summary) }}
    {{ narrative_block(data.narratives.cac) }}
    {{ footer(6, total_pages) }}
  </section>

  {# --- Page 7: Costos operacionales --- #}
  <section class="page">
    <div class="section-tag">05 · Costos operacionales</div>
    <h2>Costos operacionales y margen bruto</h2>
    <div class="grid two">
      <img class="chart" src="{{ data.figures.op_cost_composition }}" alt="Costos operacionales por servicio">
      <img class="chart" src="{{ data.figures.gross_margin_progression }}" alt="Cascada margen bruto">
    </div>
    <h3>Parámetros operativos por servicio</h3>
    {{ render_table(data.tables.costos_operacionales.parameters) }}
    <h3>Agregación anual</h3>
    {{ render_table(data.tables.costos_operacionales.summary) }}
    {{ narrative_block(data.narratives.costos_operacionales) }}
    {{ footer(7, total_pages) }}
  </section>

  {# --- Page 8: Administración --- #}
  <section class="page">
    <div class="section-tag">06 · Administración</div>
    <h2>Gastos administrativos</h2>
    {{ render_table(data.tables.administracion.summary) }}
    {{ narrative_block(data.narratives.administracion) }}
    {{ footer(8, total_pages) }}
  </section>

  {# --- Page 9: RR.HH. --- #}
  <section class="page">
    <div class="section-tag">07 · Recursos humanos</div>
    <h2>Planilla y equipo comercial</h2>
    {{ render_table(data.tables.rrhh.summary) }}
    {{ narrative_block(data.narratives.rrhh) }}
    {{ footer(9, total_pages) }}
  </section>

  {# --- Page 10: Cashflow & P&L --- #}
  <section class="page">
    <div class="section-tag">08 · Resultados (P&L)</div>
    <h2>Estructura de resultados</h2>
    <img class="chart" src="{{ data.figures.cashflow_monthly }}" alt="Cashflow mensual">
    <img class="chart" src="{{ data.figures.pnl_waterfall }}" alt="Cascada P&L último año">
    <h3>P&L anual</h3>
    {{ render_table(data.tables.pnl.summary) }}
    {{ footer(10, total_pages) }}
  </section>

  {# --- Page 11: Valorización --- #}
  <section class="page">
    <div class="section-tag">09 · Valorización</div>
    <h2>Valorización</h2>
    <img class="chart" src="{{ data.figures.valuation_methods }}" alt="Valorización por método">
    <h3>Resultados</h3>
    {{ render_table(data.tables.valorizacion.summary) }}

    <div class="vr-summary">
      <h4>Valor Residual</h4>
      <p class="vr-method">
        Método: <strong>{{ (data.dcf.valor_residual_metodo | default('none')) | upper }}</strong>
      </p>
      {% if (data.dcf.valor_residual_metodo | default('none')) == "none" %}
        <p class="vr-note">VR = 0 (enfoque conservador Maureira — recomendado para etapas seed/pre-seed)</p>
      {% elif (data.dcf.valor_residual_metodo | default('none')) == "ebitda_multiple" %}
        <p class="vr-note">VR = EBITDA<sub>T</sub> × 12 × {{ data.dcf.ebitda_multiple }}×</p>
        <p class="vr-value">VR (no descontado): {{ data.valuation.vr_nominal | money }}</p>
        <p class="vr-value">VR (VP): {{ data.valuation.vr_pv | money }}</p>
      {% elif (data.dcf.valor_residual_metodo | default('none')) == "gordon" %}
        <p class="vr-note">VR = EBITDA<sub>T</sub> × (1+g) / (WACC−g), g = {{ ((data.dcf.gordon_g | default(0)) * 100) | round(1) }}%</p>
        <p class="vr-note vr-warning">⚠ Limitación: EBITDA usado como proxy de FCF</p>
        <p class="vr-value">VR (no descontado): {{ data.valuation.vr_nominal | money }}</p>
        <p class="vr-value">VR (VP): {{ data.valuation.vr_pv | money }}</p>
      {% endif %}
    </div>

    <h3>Componentes WACC</h3>
    {{ render_table(data.tables.valorizacion.wacc) }}
    <img class="chart" src="{{ data.figures.mapvalue_diagram }}" alt="MapValue">
    {{ narrative_block(data.narratives.valorizacion) }}
    {{ footer(11, total_pages) }}
  </section>

  {# --- Page 12: Unit Economics --- #}
  <section class="page">
    <div class="section-tag">10 · Unit Economics</div>
    <h2>Unit Economics</h2>
    <img class="chart" src="{{ data.figures.unit_economics_grid }}" alt="Dashboard unit economics">
    <h3>Agregación anual</h3>
    {{ render_table(data.tables.unit_economics.annual) }}
    <h3>Detalle por métrica</h3>
    {{ render_table(data.tables.unit_economics.detail) }}
    {{ narrative_block(data.narratives.unit_economics) }}
    {{ footer(12, total_pages) }}
  </section>

  {# --- Page 13: Alertas del Modelo (10-bis) --- #}
  <section class="page">
    <div class="section-tag">10-bis · Alertas del Modelo</div>
    <h2>Alertas del Modelo (Due Diligence & Calibración)</h2>
    
    <div class="tile-grid three">
      <div class="tile {% if data.due_diligence.verdict == 'passed_with_warnings' or data.due_diligence.verdict == 'ok' %}primary{% endif %}">
        <div class="label">Veredicto Due Diligence</div>
        <div class="value" style="font-size: 15px; text-transform: uppercase;">{{ data.due_diligence.verdict | default('sin veredicto') | replace('_', ' ') }}</div>
      </div>
      <div class="tile">
        <div class="label">Fallas / Alertas</div>
        <div class="value">{{ data.due_diligence.summary.failing | default(0) }}</div>
      </div>
      <div class="tile">
        <div class="label">Calibración Técnica</div>
        <div class="value" style="font-size: 18px;">{{ data.due_diligence.calibration_verdict | default('N/A') }}</div>
      </div>
    </div>

    <h3>Fallas y Alertas Detectadas</h3>
    <table class="aggregation">
      <thead>
        <tr>
          <th>ID</th>
          <th>Regla / Nombre</th>
          <th>Severidad</th>
          <th>Mensaje / Evidencia</th>
          <th>Recomendación</th>
        </tr>
      </thead>
      <tbody>
        {% set ns = namespace(has_alerts=false) %}
        {% if data.due_diligence and data.due_diligence.findings %}
          {% for finding in data.due_diligence.findings %}
            {% if not finding.passed %}
              {% set ns.has_alerts = true %}
              <tr>
                <th scope="row">{{ finding.id }}</th>
                <td><strong>{{ finding.name }}</strong></td>
                <td style="color: {% if finding.severity_class == 'structural' or finding.severity_class == 'major' %}#EF4444{% elif finding.severity_class == 'minor' or finding.severity_class == 'warning' %}#F59E0B{% else %}#38BDF8{% endif %}; font-weight: 700;">
                  {{ finding.severity_class | upper }}
                </td>
                <td>{{ finding.message }}</td>
                <td>{{ finding.recommendation | default('—') }}</td>
              </tr>
            {% endif %}
          {% endfor %}
        {% endif %}
        {% if not ns.has_alerts %}
          <tr>
            <td colspan="5" style="text-align: center; color: #10B981; font-weight: 700; padding: 20px;">
              ✔ No se detectaron alertas críticas ni fallas de calibración en el modelo.
            </td>
          </tr>
        {% endif %}
      </tbody>
    </table>

    {{ footer(13, total_pages) }}
  </section>

  {# --- Page 14: Sensibilidad --- #}
  <section class="page">
    <div class="section-tag">11 · Sensibilidad</div>
    <h2>Análisis de Sensibilidad</h2>
    <h3>Matriz WACC × múltiplo de EBITDA</h3>
    <img class="chart" src="{{ data.figures.sensitivity_heatmap }}" alt="Heatmap sensibilidad WACC × múltiplo">
    {{ render_table(data.tables.sensibilidad.wacc) }}
    <h3>Variables operativas (tornado)</h3>
    <img class="chart" src="{{ data.figures.sensitivity_tornado }}" alt="Tornado de sensibilidad operativa">
    {{ render_table(data.tables.sensibilidad.variables) }}
    <h3>Variables para EBITDA = 0</h3>
    <img class="chart" src="{{ data.figures.breakeven_chart }}" alt="Variables breakeven">
    {{ render_table(data.tables.sensibilidad.breakeven) }}
    {{ narrative_block(data.narratives.sensibilidad) }}
    {{ footer(14, total_pages) }}
  </section>

  {# --- Page 15: Anexos --- #}
  {% if data.document.scope == "full" %}
  <section class="page">
    <div class="section-tag">12 · Anexos</div>
    <h2>Antecedentes generales</h2>
    <div class="grid two">
      <div>
        <h3>¿Qué hace la empresa?</h3>
        <p>{{ data.narrative.empresa.descripcion }}</p>
        <h3>Beneficios</h3>
        <ul>{% for item in data.narrative.empresa.beneficios %}<li>{{ item }}</li>{% endfor %}</ul>
      </div>
      <div>
        <h3>Mercado objetivo</h3>
        <p>Tipo: <strong>{{ data.narrative.target_market.tipo }}</strong></p>
        <ul>
          {% for seg in data.narrative.target_market.segmentos %}
          <li>{{ seg.nombre }} — rango {{ seg.rango_min }}–{{ seg.rango_max }} ({{ seg.id }})</li>
          {% endfor %}
        </ul>
        <h3>Modelo de negocio</h3>
        <p><strong>{{ data.narrative.modelo_negocio.principal.nombre }}</strong> · {{ data.narrative.modelo_negocio.principal.descripcion }}</p>
        <p class="muted">{{ data.narrative.modelo_negocio.principal.ticket_descripcion }}</p>
      </div>
    </div>
    {{ footer(15, total_pages) }}
  </section>
  {% endif %}

  {# --- Última página: Anexo metodológico (trazabilidad de fórmulas) --- #}
  <section class="page">
    <div class="section-tag">{{ "12" if data.document.scope == "ev_only" else "13" }} · Anexo metodológico</div>
    <h2>Anexo metodológico: trazabilidad de fórmulas</h2>
    <p class="muted">Definiciones de cálculo de cada sección del informe. La formulación
    matemática completa del modelo de optimización se documenta en la especificación
    técnica de Adventure Capital (MATHEMATICAL_FORMULATION).</p>
    {{ formula_block("Clientes", "Clientes_t  = Clientes_{t-1} * (1 - churn_rate) + Nuevos_t\nNuevos_t    = eff_sales * active_vendedores_t\nActivos_t   = Activos_{t-1} + hires_t - exits_t") }}
    {{ formula_block("Servicios", "Mix_s_t     = Clientes_s_t / Clientes_total_t            [fraccion por servicio s]\nPenetration_s_t = Clientes_s_t / TAM_s                   [si TAM disponible]") }}
    {{ formula_block("Ingresos", "Ingresos_t  = Sum_s [ Clientes_s_t * ARPU_s ]\nARPU_s      = precio_base_s * (1 + upsell_rate_s)        [si aplica]") }}
    {{ formula_block("CAC", "CAC_t       = Costo_adquisicion_t / Nuevos_t\nCosto_adq_t = salarios_ventas_t + marketing_t + overhead_ventas_t") }}
    {{ formula_block("Costos operacionales", "Costo_op_t  = Sum_s [ Clientes_s_t * costo_unitario_s ]\nMargen_op_s = 1 - (costo_unitario_s / ARPU_s)") }}
    {{ formula_block("P&L", "EBITDA_t    = Ingresos_t - Costo_op_t - CAC_t - G_adm_t - RRHH_t\nEBITDA_pct_t  = EBITDA_t / Ingresos_t") }}
    {{ formula_block("Valorización DCF", "EV          = Sum_{t=1}^{T} [ FCF_t / (1 + WACC)^t ] + VR / (1 + WACC)^T\nWACC        = Rf + beta * (Rm - Rf) + Rp          [CAPM model]\nVR          = según método configurado (ver Fase E)") }}
    {{ formula_block("Unit Economics", "LTV_s       = ARPU_s * GP_s / churn_rate_s      [vida util = 1/churn]\nLTV/CAC_s   = LTV_s / CAC_t                     [ratio de adquisicion]\nPayback_s   = CAC_t / (ARPU_s * GP_s)           [recuperacion CAC]\nGP_s        = 1 - (costo_unitario_s / ARPU_s)   [margen bruto]") }}
    {{ formula_block("Sensibilidad", "dEV/dWACC   = dEV/dWACC  [numerical sensitivity]\ndEV/dmult   = EV(mult+1) - EV(mult)\nBreakeven   = t_star such that EBITDA_acum_{t_star} = 0") }}
    {{ footer(total_pages, total_pages) }}
  </section>
</body>
</html>
